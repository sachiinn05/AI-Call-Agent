{
  "name": "lipi-ai-call-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lipi.ai — an outbound sales voice agent: calls a lead, holds a real conversation, answers questions from a PDF, and books a meeting",
  "scripts": {
    "dev": "tsx watch backend/server.ts",
    "start": "tsx backend/server.ts",
    "sim": "tsx backend/cli.ts sim",
    "dial": "tsx backend/cli.ts dial",
    "ingest": "tsx backend/cli.ts ingest",
    "kb:build": "tsx scripts/build-knowledge-pdf.ts",
    "mail:test": "tsx scripts/mail-test.ts",
    "tunnel": "ngrok http 3001",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "voices": "tsx scripts/voices.ts",
    "web:install": "npm --prefix frontend install",
    "web:dev": "npm --prefix frontend run dev",
    "web:build": "npm --prefix frontend run build",
    "verify": "npm run typecheck && npm test && npm run web:build"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "js-tiktoken": "^1.0.21",
    "msedge-tts": "^2.1.0",
    "nodemailer": "^10.0.15",
    "pdf-parse": "^2.4.5",
    "sarvamai": "^1.1.10",
    "tsx": "^4.23.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
